<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícone adaptativo: arte em bitmap (drawable-nodpi/ic_launcher_foreground.png)
  sobre fundo preto, para a moldura prateada aparecer inteira na área visível
  de 72dp. A versão monocromática continua vetorial, para os ícones temáticos.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
