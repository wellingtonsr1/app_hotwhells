<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema mínimo da janela. As cores reais vêm de HotWheelsTheme (Compose).
      Fundo escuro evita flash branco na abertura, que é justamente o momento do startup.
    -->
    <style name="Theme.HotWheelsCollector" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
