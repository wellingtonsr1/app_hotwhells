<?xml version="1.0" encoding="utf-8"?>
<!--
  Camada de frente do ícone adaptativo: silhueta lateral de uma miniatura 1:64.
  Desenho geométrico próprio, sem ativo de terceiros (A9 da constituição).
  Conteúdo limitado ao círculo seguro de 72dp do canvas de 108dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Grupo deslocado 5dp para cima: a silhueta crua tem centro em y≈59,5 no canvas
      de 108dp, o que a deixava visivelmente baixa dentro da máscara circular.
    -->
    <group android:translateY="-5">

    <!-- Carroceria em Chalk (#F4F1EE). -->
    <path
        android:fillColor="#F4F1EE"
        android:pathData="M27.5,68 L27.5,60.6 C27.5,58.2 28.6,56.8 31.1,56.4 L44.8,54.9 L52.4,47.3 C53.5,46.2 54.9,45.7 56.5,45.7 L65.4,45.7 L73.4,54.9 L76.9,55.3 C79.5,55.7 80.9,57.3 80.9,59.9 L80.9,68 Z" />

    <!-- Faixa lateral em HotOrange (#F26B21), marca da miniatura. -->
    <path
        android:pathData="M33.2,62.2 L74.9,62.2"
        android:strokeColor="#F26B21"
        android:strokeWidth="2.1"
        android:strokeLineCap="round" />

    <!-- Rodas: discos na cor do fundo, lendo como vazado da silhueta. -->
    <path
        android:fillColor="#D3242B"
        android:pathData="M40.2,68 m-5.3,0 a5.3,5.3 0 1,0 10.6,0 a5.3,5.3 0 1,0 -10.6,0" />
    <path
        android:fillColor="#D3242B"
        android:pathData="M68.2,68 m-5.3,0 a5.3,5.3 0 1,0 10.6,0 a5.3,5.3 0 1,0 -10.6,0" />
    </group>
</vector>
