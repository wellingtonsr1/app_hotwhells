<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícone vazio do splash do Android 12+: a janela do sistema mostra só o fundo da paleta e
  a arte completa da abertura entra em seguida, sem repetir a marca. Sem este recurso o
  sistema voltaria a desenhar o ícone do app por padrão.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="1dp"
        android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>
